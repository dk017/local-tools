# SECURE LICENSE VALIDATION CONFIGURATION
# The desktop app now uses a backend validation service instead of embedding the API key

# Backend Validation Service URL
# This is the URL of your validation service (deployed with your website)
# IMPORTANT: Replace 'yourwebsite.com' with your actual domain
VALIDATION_SERVICE_URL=https://yourwebsite.com/api/desktop

# For local development, use:
# VALIDATION_SERVICE_URL=http://localhost:3000/api/desktop

# Development Mock License (optional, for testing without API calls)
# Uncomment to enable mock license activation (keys must start with "test_")
# DEV_MOCK_LICENSE=true
