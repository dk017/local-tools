# Payment Provider Configuration
# Choose either Polar.sh (recommended) or LemonSqueezy

# ============ POLAR.SH (Recommended) ============
# Get your access token from: https://polar.sh/settings/developers
POLAR_ACCESS_TOKEN=your_polar_access_token_here
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here
POLAR_SUCCESS_URL=https://localtools.pro/success?checkout_id={CHECKOUT_ID}
# Direct checkout link (recommended) - from Products > Checkout Links
NEXT_PUBLIC_POLAR_CHECKOUT_URL=https://buy.polar.sh/polar_cl_xxxxx
# Or use product ID for API-based checkout
NEXT_PUBLIC_POLAR_PRODUCT_ID=your_polar_product_id_here
# Organization ID from: https://polar.sh/dashboard/settings (required for license validation)
POLAR_ORGANIZATION_ID=your_polar_organization_id_here

# ============ LEMONSQUEEZY (Legacy) ============
# Get your API key from: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=your_api_key_here
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=your_checkout_url_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret_here
